[Unit]
Description=GPU Hub do laboratório (Ray head node + proxy autenticado)
Documentation=https://github.com/Gabriel-Richard-dev/GpuHub
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__REPO_DIR__/docker
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
# O `docker compose up` de uma imagem já construída é rápido, mas o primeiro
# boot depois de um rebuild pode demorar; não vale matar por timeout.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
