# Ray head node + dashboard, com passthrough de GPU via nvidia-container-toolkit.
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# PY_VERSION segue o requires-python do vigia-ia-lab (fonte da verdade — é
# quem consome essa GPU compartilhada). Mantenha igual ao PY_VERSION de
# scripts/setup_dev.sh e scripts/setup_hub.sh: o Ray Client exige a mesma
# versão major.minor dos dois lados da conexão. Instalamos via `uv` em vez
# do python3 do apt: a imagem base (Ubuntu 22.04) só oferece 3.10 por
# padrão, e isso desacopla a versão do Python da versão do Ubuntu da base.
ARG PY_VERSION=3.11

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /opt/gpuhub
COPY pyproject.toml README.md ./
COPY gpuhub ./gpuhub

RUN uv venv --python "${PY_VERSION}" /opt/gpuhub/.venv
RUN uv pip install --python /opt/gpuhub/.venv/bin/python --no-cache .
ENV PATH="/opt/gpuhub/.venv/bin:$PATH"

COPY scripts/start_hub_docker.sh /usr/local/bin/start_hub
RUN chmod +x /usr/local/bin/start_hub

EXPOSE 6379 8265 10001 8000

CMD ["start_hub"]
