# Ray head node, com passthrough de GPU via nvidia-container-toolkit.
#
# Só sobe o cluster Ray — quem manda jobs é o `vigia-gpu-submit`
# (vigia-ia-lab/vigia/gpuclient.py), via API de Jobs nativa do Ray
# (dashboard em :8265). Este repo não roda mais nenhum código Python
# custom, só instala o que o Ray e o vigia-ia-lab precisam.
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# PY_VERSION segue o requires-python do vigia-ia-lab (fonte da verdade — é
# quem consome essa GPU compartilhada). Mantenha igual ao PY_VERSION de
# scripts/setup_hub.sh: o Ray Client exige a mesma versão major.minor dos
# dois lados da conexão. Instalamos via `uv` em vez do python3 do apt: a
# imagem base (Ubuntu 22.04) só oferece 3.10 por padrão, e isso desacopla a
# versão do Python da versão do Ubuntu da base.
ARG PY_VERSION=3.11

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
        libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Por padrão o uv guarda o interpretador que ele baixa em /root/.local, e
# /root é 0700: o venv vira um symlink que só o root consegue seguir, e o
# container quebra com "bad interpreter: Permission denied" ao rodar como
# usuário comum. Em /opt todo mundo lê.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN uv venv --python "${PY_VERSION}" /opt/gpuhub-venv
ENV PATH="/opt/gpuhub-venv/bin:$PATH"

# `pip` é instalado de propósito: o `uv venv` cria o ambiente SEM pip, e o Ray
# monta o runtime_env de um job derivando um virtualenv daqui e chamando
# `python -m pip`. Sem isto, todo job com requirements.txt morre com
# "No module named pip" — que é o que empurra as pessoas a instalar pacote na
# mão dentro do container (e perder tudo no próximo restart).
#
# ray[default] pra rodar o head node + Jobs API. O resto é a stack do
# vigia-ia-lab pré-instalada (evita instalar torch/deepface etc. na
# primeira execução de cada job). Mantenha esta lista igual aos
# `dependencies` de vigia-ia-lab/pyproject.toml (fonte da verdade).
# onnx/onnxscript estavam sendo instalados na mão com `docker exec ... pip
# install`: funciona até o container ser recriado, e aí somem sem aviso. O
# lugar de dependência do hub é aqui.
RUN uv pip install --python /opt/gpuhub-venv/bin/python --no-cache \
        "ray[default]==2.57.0" \
        "pip" \
        "numpy==1.26.4" \
        "opencv-python-headless==4.10.0.84" \
        "mediapipe==0.10.18" \
        "deepface>=0.0.93" \
        "tf-keras>=2.16.0" \
        "torch" \
        "torchvision" \
        "facenet-pytorch" \
        "onnx" \
        "onnxscript"

# Os jobs rodam com a identidade de quem sobe o Ray. Como qualquer pessoa
# autenticada no hub pode submeter código arbitrário, esse alguém não pode ser
# o root: com network_mode host e /mnt/pesquisa montado, root no container é
# root na máquina do lab. UID fixo (não "o próximo livre") porque ele precisa
# casar com o dono de /mnt/pesquisa no host — veja scripts/install_host.sh.
ARG GPUHUB_UID=2000
RUN useradd --create-home --uid "${GPUHUB_UID}" --shell /bin/bash gpuhub \
    && mkdir -p /tmp/ray \
    && chown gpuhub:gpuhub /tmp/ray

COPY scripts/lib_hub_ip.sh /usr/local/bin/lib_hub_ip.sh
COPY scripts/start_hub_docker.sh /usr/local/bin/start_hub
RUN chmod +x /usr/local/bin/start_hub /usr/local/bin/lib_hub_ip.sh

# 8265 e 10001 ficam em localhost (veja start_hub_docker.sh): quem entra de
# fora entra pelo Caddy, nunca direto no Ray, que não tem autenticação nenhuma.
EXPOSE 6379 8265 10001

USER gpuhub
CMD ["start_hub"]
